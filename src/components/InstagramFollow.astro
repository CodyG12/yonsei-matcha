---
import { Image } from 'astro:assets';
import marketSign from '../assets/images/market-sign-matcha.jpg';
import marketPrep from '../assets/images/market-prep.jpg';
import strawberryMatcha from '../assets/images/strawberry-matcha.jpg';
import matchaHojichaPair from '../assets/images/matcha-hojicha-pair.jpg';
import bananaStrawberryBoard from '../assets/images/banana-strawberry-matcha-board.jpg';
import marketStandDrinks from '../assets/images/market-stand-drinks.jpg';
import strawberryHojichaBoard from '../assets/images/strawberry-hojicha-board.jpg';
import bananaCreamCloseup from '../assets/images/banana-cream-matcha-closeup.jpg';

const igHandle = 'yonseimatcha'; // TODO: confirm the real Instagram handle
---
<section class="section">
  <div class="wrap">
    <div class="follow reveal">
      <div class="kicker">Stay in the loop</div>
      <h2>Follow along on Instagram</h2>
      <p>Weekly market schedules, new specials, and pop-up announcements go up there first.</p>
      <div class="ig-grid">
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={marketSign} alt="Yonsei Matcha market sign with a fresh matcha latte" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={marketPrep} alt="Preparing drinks at the Yonsei Matcha market table" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={strawberryMatcha} alt="Iced strawberry matcha latte topped with a dried strawberry" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={matchaHojichaPair} alt="A hojicha latte and a strawberry matcha latte side by side" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={bananaStrawberryBoard} alt="A banana cream matcha latte and an iced strawberry matcha latte on a wooden board" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={marketStandDrinks} alt="Matcha drinks at the market stand with the Yonsei Matcha sign in the background" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={strawberryHojichaBoard} alt="An iced strawberry matcha latte and a hojicha latte on a decorated wooden board" width={320} height={320} loading="lazy" />
        </a>
        <a href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener" aria-label="See this photo on Instagram">
          <Image src={bananaCreamCloseup} alt="Close-up of a banana cream matcha latte topped with crushed cookie and a freeze-dried banana chip" width={320} height={320} loading="lazy" />
        </a>
      </div>
      <a class="btn btn-primary" href={`https://instagram.com/${igHandle}`} target="_blank" rel="noopener">
        @{igHandle} →
      </a>
    </div>
  </div>
</section>

<style>
  .follow {
    background: var(--ink);
    color: var(--cream);
    border-radius: var(--radius-soft);
    padding: 68px 24px;
    text-align: center;
  }

  .follow .kicker {
    color: var(--mint);
  }

  .follow h2 {
    color: var(--cream);
    font-size: clamp(28px, 4vw, 40px);
    margin-top: 8px;
  }

  .follow p {
    opacity: 0.75;
    max-width: 40ch;
    margin: 14px auto 0;
    line-height: 1.6;
  }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    max-width: 520px;
    margin: 34px auto 0;
  }

  .ig-grid a {
    aspect-ratio: 1;
    border-radius: 14px;
    display: block;
    overflow: hidden;
    transition: opacity 0.2s;
  }

  .ig-grid a:hover,
  .ig-grid a:focus-visible {
    opacity: 0.85;
  }

  .ig-grid a img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .follow :global(.btn-primary) {
    margin-top: 30px;
    background: var(--mint);
    color: var(--ink);
  }
</style>
